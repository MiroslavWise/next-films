generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

enum VoteChoice {
  WATCH_MANY
  WATCH_ONCE
  REMOVE
}

model Movie {
  id                      String   @id @default(uuid(7)) @db.Uuid
  title                   String   @unique
  posterUrl               String
  posterBlurhash          String
  watchManyCount          Int      @default(0)
  onceEnoughCount         Int      @default(0)
  removeFromIndustryCount Int      @default(0)
  /// Победы в раунде 1/16 → выход в топ-16
  playoffIn16Count        Int      @default(0)
  /// Победы в 1/8 → топ-8
  playoffIn8Count         Int      @default(0)
  /// Победы в 1/4 → топ-4
  playoffIn4Count         Int      @default(0)
  /// Победы в 1/2 → финал (топ-2)
  playoffIn2Count         Int      @default(0)
  /// Победы в финале
  playoffVictoryCount     Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  genres            MovieGenre[]
  actors            MovieActor[]
  directors         MovieDirector[]
  producers         MovieProducer[]
  votes             Vote[]
  playoffFinalists  PlayoffTournament[] @relation("PlayoffFinalist")
  frameGuessEntry   FrameGuessEntry?
}

model Genre {
  id        String       @id @default(uuid(7)) @db.Uuid
  name      String
  nameKey   String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  movies    MovieGenre[]
}

model Actor {
  id           String       @id @default(uuid(7)) @db.Uuid
  name         String
  nameKey      String       @unique
  photoUrl     String?
  photoBlurhash String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  movies       MovieActor[]
}

model Director {
  id            String          @id @default(uuid(7)) @db.Uuid
  name          String
  nameKey       String          @unique
  photoUrl      String?
  photoBlurhash String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  movies        MovieDirector[]
}

model Producer {
  id            String          @id @default(uuid(7)) @db.Uuid
  name          String
  nameKey       String          @unique
  photoUrl      String?
  photoBlurhash String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  movies        MovieProducer[]
}

model MovieGenre {
  movieId String @db.Uuid
  genreId String @db.Uuid
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Restrict)

  @@id([movieId, genreId])
  @@index([genreId])
}

model MovieActor {
  movieId String @db.Uuid
  actorId String @db.Uuid
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  actor   Actor  @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@id([movieId, actorId])
  @@index([actorId])
}

model MovieDirector {
  movieId    String   @db.Uuid
  directorId String   @db.Uuid
  movie      Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  director   Director @relation(fields: [directorId], references: [id], onDelete: Restrict)

  @@id([movieId, directorId])
  @@index([directorId])
}

model MovieProducer {
  movieId    String   @db.Uuid
  producerId String   @db.Uuid
  movie      Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  producer   Producer @relation(fields: [producerId], references: [id], onDelete: Restrict)

  @@id([movieId, producerId])
  @@index([producerId])
}

model TelegramUser {
  id           String   @id
  username     String?
  firstName    String?
  lastName     String?
  languageCode String?
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @updatedAt
  votes        Vote[]
  playoffs     PlayoffTournament[]
  frameGuessSessions FrameGuessSession[]
}

model Vote {
  id        String     @id @default(uuid(7)) @db.Uuid
  userId    String
  movieId   String     @db.Uuid
  choice    VoteChoice
  createdAt DateTime   @default(now())

  user  TelegramUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie        @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([userId])
  @@index([movieId])
}

enum PlayoffStatus {
  GAME
  PRE_END
  END
}

model PlayoffTournament {
  id              String        @id @default(uuid(7)) @db.Uuid
  userId          String
  status          PlayoffStatus @default(GAME)
  /// 0 = 1/16 (32→16) … 4 = финал; при PRE_END/END = 5
  roundIndex      Int           @default(0)
  bracket         Json
  finalistMovieId String?       @db.Uuid
  version         Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user     TelegramUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  finalist Movie?       @relation("PlayoffFinalist", fields: [finalistMovieId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, createdAt])
}

/// Кадры для игры «Угадай кадр»: одна запись на фильм, frames — JSON-массив { id, url, blurhash }
model FrameGuessEntry {
  id        String   @id @default(uuid(7)) @db.Uuid
  movieId   String   @unique @db.Uuid
  frames    Json     @default("[]")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([isActive])
}

enum FrameGuessSessionStatus {
  ACTIVE
  ENDED
}

/// Партия «Угадай кадр» — аналог PlayoffTournament для истории игрока
model FrameGuessSession {
  id            String                  @id @default(uuid(7)) @db.Uuid
  userId        String
  status        FrameGuessSessionStatus @default(ACTIVE)
  correctCount  Int                     @default(0)
  answeredCount Int                     @default(0)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  endedAt       DateTime?

  user   TelegramUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  rounds FrameGuessRound[]

  @@index([userId, status])
  @@index([userId, createdAt])
}

/// Один вопрос внутри партии; снимок кадра/вариантов для истории
model FrameGuessRound {
  id             String    @id @default(uuid(7)) @db.Uuid
  sessionId      String    @db.Uuid
  userId         String
  frameId        String
  imageUrl       String
  imageBlurhash  String
  correctMovieId String    @db.Uuid
  correctTitle   String
  /// [{ "movieId": "...", "title": "..." }, ...] — уже перемешанные варианты
  options        Json
  chosenMovieId  String?   @db.Uuid
  isCorrect      Boolean?
  createdAt      DateTime  @default(now())
  answeredAt     DateTime?

  session FrameGuessSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId, answeredAt])
}
